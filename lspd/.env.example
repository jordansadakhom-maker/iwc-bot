# ── Plateforme LSPD — variables d'environnement ───────────────────────────────
# Copie ce fichier en « .env.local » (jamais committé) et renseigne les valeurs.
# Sur Vercel : Settings → Environment Variables.

# Supabase (projet DÉDIÉ au LSPD, séparé de Red Dead) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Verrouillage de l'accès interne (true par défaut). "false" ouvre tout — dev seulement.
REQUIRE_AUTH=true

# Fuseau horaire d'affichage (défaut : Europe/Paris)
LSPD_TZ=Europe/Paris
